{
  "name": "neohtop",
  "version": "1.3.0",
  "description": "NeoHtop desktop app tooling: website build and release checks",
  "type": "module",
  "scripts": {
    "format": "prettier --write ./scripts ./docs ./site ./telemetry .github/workflows && cargo fmt",
    "format:check": "prettier --check ./scripts ./docs ./site ./telemetry .github/workflows && cargo fmt -- --check",
    "release:check": "node scripts/release.mjs check-version",
    "test:release": "node --test scripts/*.test.mjs",
    "prepare": "husky install",
    "build:site": "node scripts/build-site.mjs",
    "refresh:site-release": "node scripts/refresh-site-release.mjs",
    "refresh:site-stats": "node scripts/refresh-site-stats.mjs",
    "export:themes": "node scripts/export-themes.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "vite": "^6.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@lucide/svelte": "^1.63.0",
    "tailwind-variants": "^3.3.1",
    "cn": "^0.5.0",
    "tw-animate-css": "^1.4.0",
    "shadcn-svelte": "^1.7.1"
  },
  "lint-staged": {
    "{site,scripts,docs,telemetry}/**/*.{js,mjs,ts,svelte}": [
      "prettier --write"
    ],
    "src/**/*.rs": [
      "cargo fmt --"
    ]
  }
}
